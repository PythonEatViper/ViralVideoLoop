<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{label}}</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>{{repo}}/engine/schedule/director_daily.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>{{hour}}</integer><key>Minute</key><integer>{{minute}}</integer></dict>
  <key>StandardOutPath</key><string>{{repo}}/engine/schedule/director.log</string>
  <key>StandardErrorPath</key><string>{{repo}}/engine/schedule/director.log</string>
</dict>
</plist>
